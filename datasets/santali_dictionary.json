  "parallel_sentences": [
    {
      "id": 1,
      "hin": "सबको जोहार।",
      "sat_olchiki": "ᱥᱟᱱᱟᱢ ᱠᱚ ᱡᱚᱦᱟᱨ᱾",
      "sat_odia": "ସାନାମ କୋ ଜୋହାର ।",
      "eng": "Greetings to everyone."
    },
    {
      "id": 2,
      "hin": "आज हम गणित पढ़ेंगे।",
      "sat_olchiki": "ᱛᱮᱦᱮᱧ ᱵᱚᱱ ᱞᱮᱠᱷᱟ ᱵᱚᱱ ᱯᱟᱲᱦᱟᱣᱟ᱾",
      "sat_odia": "ତେହେଞ୍ଜ ବୋନ ଲେଖା ବୋନ ପାଡ଼ହାୱା ।",
      "eng": "Today we will study mathematics."
    },
    {
      "id": 3,
      "hin": "किताब खोलो।",
      "sat_olchiki": "ᱯᱩᱛᱷᱤ ᱡᱷᱤᱡᱽ ᱢᱮ᱾",
      "sat_odia": "ପୁଥି ଝିଜ ମେ ।",
      "eng": "Open the book."
    },
    {
      "id": 4,
      "hin": "साफ लिखो।",
      "sat_olchiki": "ᱥᱟᱯᱷᱟ ᱚᱞ ᱢᱮ᱾",
      "sat_odia": "ସାଫା ଅଲ ମେ ।",
      "eng": "Write clearly."
    },
    {
      "id": 5,
      "hin": "सब बैठ जाओ।",
      "sat_olchiki": "ᱥᱟᱱᱟᱢ ᱠᱚ ᱫᱩᱲᱩᱵ ᱯᱮ᱾",
      "sat_odia": "ସାନାମ କୋ ଦୁଡ଼ୁବ ପେ ।",
      "eng": "Everyone please sit down."
    },
    {
      "id": 6,
      "hin": "क्या आप पढ़ना लिखना जानते हैं?",
      "sat_olchiki": "ᱟᱢ ᱚᱞ ᱯᱟᱲᱦᱟᱣ ᱮᱢ ᱵᱟᱰᱟᱭᱟ ᱥᱮ?",
      "sat_odia": "ଆମ ଓଲଗ ପଢ଼ହବ ଏମ ବଦୟ ସେ?",
      "eng": "Do you know how to read and write ?"
    },
    {
      "id": 7,
      "hin": "क्या सब कुशल मंगल है?",
      "sat_olchiki": "ᱥᱟᱱᱟᱢᱟᱜ ᱱᱟᱯᱟᱭ ᱜᱮ ᱛᱚ?",
      "sat_odia": "ସାନଅମଗ ନପାୟ ଗେଟୋ?",
      "eng": "Are you fine ?"
    }
  ]
